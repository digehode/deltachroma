---
import { getCollection } from 'astro:content';
import { paths } from '../../consts';
import BaseLayout from '../../layouts/BaseLayout.astro';
// Fetch all blog posts and sort them by date (newest first)
const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="Blog" description="Development logs and architectural notes for DeltaChroma.">
  <div class="blog-container">
    <h1>Development Blog</h1>
    <p class="subtitle">Notes on OKLCH math, accessibility optimization, and building DeltaChroma.</p>

    <div class="post-list">
      {sortedPosts.map((post) => {
      const postSlug = post.data.slug || post.id.replace(/\.(md|mdx)$/, '');
      return (
        <article class="post-card">
          <h2>
	  <a href={`${paths.blog}/${postSlug}`}>{post.data.title}</a>
	  
          </h2>
          <time datetime={post.data.pubDate.toISOString()}>
            {post.data.pubDate.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })}
          </time>
          <p>{post.data.description}</p>
        </article>
      )}
      )}
    </div>
  </div>
</BaseLayout>
