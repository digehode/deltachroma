---
import '@/styles/deltachroma-app.css';
---

<div class="deltachroma-app" id="deltachroma-root">
  <div class="card-panel">

    <!-- Background Surfaces Section -->
    <section class="deltachroma-section">
      <h2>Background Surfaces</h2>
      <div class="grid-two-cols">
        
        <!-- Light Mode Background Block -->
        <div class="color-control-box">
          <div>
            <h3>Light Mode Background</h3>
            <label for="light-bg-input">Background Color</label>
          </div>
          <div>
            <input 
              type="text" 
              id="light-bg-input" 
              class="coloris-input fixed-data deltachroma-picker" 
              value="#ffffff" 
              data-coloris
            />
          </div>
          
          <div id="light-swatch" class="swatch" ></div>

          <div class="color-formats">
            <div class="format-row">
              <span class="format-label">HEX:</span>
              <span id="light-hex" class="fixed-data">#ffffff</span>
            </div>
            <div class="format-row">
              <span class="format-label">RGB:</span>
              <span id="light-rgb" class="fixed-data">rgb(255, 255, 255)</span>
            </div>
            <div class="format-row">
              <span class="format-label">OKLCH:</span>
              <span id="light-oklch" class="fixed-data">oklch(1 0 0)</span>
            </div>
          </div>
          <div class="color-validation text-small text-bold" id="light-validation"></div>
        </div>

        <!-- Dark Mode Background Block -->
        <div class="color-control-box">
          <div>
            <h3>Dark Mode Background</h3>
            <label for="dark-bg-input">Background Color</label>
          </div>
          <div>
            <input 
              type="text" 
              id="dark-bg-input" 
              class="coloris-input fixed-data deltachroma-picker" 
              value="#121212" 
              data-coloris
            />
          </div>
          
          <div id="dark-swatch" class="swatch" ></div>

          <div class="color-formats">
            <div class="format-row">
              <span class="format-label">HEX:</span>
              <span id="dark-hex" class="fixed-data">#121212</span>
            </div>
            <div class="format-row">
              <span class="format-label">RGB:</span>
              <span id="dark-rgb" class="fixed-data">rgb(18, 18, 18)</span>
            </div>
            <div class="format-row">
              <span class="format-label">OKLCH:</span>
              <span id="dark-oklch" class="fixed-data">oklch(0.2 0 0)</span>
            </div>
          </div>
          <div class="color-validation text-small text-bold" id="dark-validation"></div>
        </div>

      </div>
    </section>

    <!-- Seed Colours Section -->
    <section class="deltachroma-section">
      <h2>Seed Colours</h2>
      <div class="grid-two-cols">
        <!-- Light Seed Colours -->
        <div class="color-control-box">
          <h3>Light Seed Colours</h3>
          <div id="light-seeds">
            <!-- Seed inputs will be added dynamically -->
          </div>
          <button type="button" id="add-light-seed-btn" class="btn-secondary">+ Add Seed</button>
        </div>

        <!-- Dark Seed Colours -->
        <div class="color-control-box">
          <h3>Dark Seed Colours</h3>
          <div id="dark-seeds">
            <!-- Seed inputs will be added dynamically -->
          </div>
          <button type="button" id="add-dark-seed-btn" class="btn-secondary">+ Add Seed</button>
        </div>
      </div>
    </section>
  </div>
</div>

<!-- Wire up the Coloris picker and the background-color cards -->
<script>
  import { initColorisPicker } from '../scripts/coloris-picker';
  import { initDeltaChromaUI } from '../scripts/deltachroma-ui';

  initColorisPicker();
  const root = document.getElementById('deltachroma-root');
  if (root) {
    initDeltaChromaUI(root);
  }
</script>